# Azure AI Foundry Configuration
# Copy this to .env and fill in your actual values

# Your Azure AI Foundry project endpoint
# Example: https://your-project.region.inference.ml.azure.com
PROJECT_ENDPOINT=

# Your model deployment name (e.g., gpt-4, gpt-35-turbo)
MODEL_DEPLOYMENT_NAME=

# Bing Search connection resource name from Azure AI Foundry
# Format: /subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<connection-name>
BING_CONNECTION_NAME=

# Optional: Azure subscription ID
AZURE_SUBSCRIPTION_ID=

# Optional: Resource group name
AZURE_RESOURCE_GROUP=
